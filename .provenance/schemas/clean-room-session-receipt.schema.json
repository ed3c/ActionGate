{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:actiongate:provenance:clean-room-session-receipt:v1",
  "title": "ActionGate clean-room session receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "session_id",
    "repository",
    "subject_sha",
    "output_commit",
    "output_tree",
    "started_at",
    "completed_at",
    "runtime",
    "permitted_sources",
    "forbidden_sources",
    "personal_device_used",
    "personal_account_used",
    "employer_source_accessed",
    "employer_resources_used",
    "employer_time_used",
    "private_urls_echoed",
    "changed_paths",
    "dco_state",
    "dco_evidence",
    "evidence_state"
  ],
  "properties": {
    "schema": {"const": "clean-room-session-receipt/v1"},
    "session_id": {"type": "string", "minLength": 1},
    "repository": {"const": "ed3c/ActionGate"},
    "subject_sha": {
      "oneOf": [
        {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        {"const": "ABSENT_AT_START"}
      ]
    },
    "output_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "output_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "runtime": {"type": "string", "minLength": 1},
    "permitted_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "id", "locator", "commit", "tree"],
        "properties": {
          "type": {"enum": ["PUBLIC_GIT", "PUBLIC_SPEC", "ACTIONGATE_SUBJECT", "SYNTHETIC_FIXTURE"]},
          "id": {"type": "string", "minLength": 1},
          "locator": {"type": "string", "minLength": 1},
          "commit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
          "tree": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"}
        }
      }
    },
    "forbidden_sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "personal_device_used": {"const": true},
    "personal_account_used": {"const": true},
    "employer_source_accessed": {"const": false},
    "employer_resources_used": {"const": false},
    "employer_time_used": {"const": false},
    "private_urls_echoed": {"const": false},
    "changed_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "dco_state": {"enum": ["PASS", "NOT_APPLICABLE_WITH_EVIDENCE"]},
    "dco_evidence": {"type": "string", "minLength": 1},
    "evidence_state": {"const": "PASS"}
  }
}
