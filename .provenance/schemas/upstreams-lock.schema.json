{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:actiongate:provenance:upstreams-lock:v1",
  "title": "ActionGate upstream lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "repository",
    "state",
    "source_policy",
    "no_source_imports_admitted",
    "legal_admission",
    "release_state",
    "upstreams"
  ],
  "properties": {
    "schema": {"const": "actiongate-upstream-lock/v1"},
    "repository": {"const": "ed3c/ActionGate"},
    "state": {"enum": ["UPSTREAM_SELECTION_REQUIRED", "UPSTREAMS_ADMITTED"]},
    "source_policy": {"const": "PUBLIC_ENUMERATED_ONLY"},
    "no_source_imports_admitted": {"type": "boolean"},
    "legal_admission": {"enum": ["HUMAN_ADMIT_REQUIRED", "HUMAN_ADMITTED"]},
    "release_state": {"enum": ["BLOCKED", "RELEASE_ELIGIBLE"]},
    "upstreams": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "repository",
          "commit",
          "tree",
          "tag",
          "license_spdx",
          "license_sha256",
          "relationship",
          "imported_paths",
          "excluded_paths",
          "observed_at"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
          "name": {"type": "string", "minLength": 1, "maxLength": 200},
          "repository": {"type": "string", "pattern": "^https://[^\\s]+$"},
          "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "tag": {"type": ["string", "null"]},
          "license_spdx": {"type": "string", "minLength": 1, "not": {"enum": ["UNKNOWN", "NOASSERTION"]}},
          "license_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "relationship": {"enum": ["DERIVED_SOURCE", "DEPENDENCY", "REFERENCE_IMPLEMENTATION", "SPECIFICATION_ONLY", "BUILD_TOOLING"]},
          "imported_paths": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "excluded_paths": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "observed_at": {"type": "string", "format": "date-time"}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"state": {"const": "UPSTREAM_SELECTION_REQUIRED"}}},
      "then": {
        "properties": {
          "upstreams": {"maxItems": 0},
          "no_source_imports_admitted": {"const": true},
          "release_state": {"const": "BLOCKED"},
          "legal_admission": {"const": "HUMAN_ADMIT_REQUIRED"}
        }
      }
    },
    {
      "if": {"properties": {"state": {"const": "UPSTREAMS_ADMITTED"}}},
      "then": {"properties": {"upstreams": {"minItems": 1}}}
    }
  ]
}
