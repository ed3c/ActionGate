{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://actiongate.dev/contracts/evidence/common/language-worker-receipt.schema.json",
  "title": "ActionGate C01 language-worker receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "evidence_kind", "repository", "issue", "language",
    "base_sha", "head_sha", "tree_sha", "branch", "lease",
    "changed_paths", "runtime", "contract_digests", "positive_results",
    "negative_results", "denominator", "dependencies", "rights_state",
    "clean_room_state", "shadow", "evidence_lane", "evidence_state",
    "blockers", "rollback", "human_owned"
  ],
  "properties": {
    "schema": {"const": "actiongate-c01-language-worker-receipt/v1"},
    "evidence_kind": {"enum": ["LIVE", "FIXTURE"]},
    "repository": {"const": "ed3c/ActionGate"},
    "issue": {"enum": [18, 19, 20]},
    "language": {"enum": ["kotlin", "swift", "typescript"]},
    "base_sha": {"const": "b63589e5a16e82fda1a9554227f2ebbb55398c8a"},
    "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "tree_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "branch": {"type": "string", "minLength": 1, "maxLength": 256},
    "lease": {
      "type": "object", "additionalProperties": false,
      "required": ["paths", "resources"],
      "properties": {
        "paths": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "resources": {"type": "array", "items": {"type": "string"}}
      }
    },
    "changed_paths": {"type": "array", "items": {"type": "string"}},
    "runtime": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "commands", "versions", "runtime_scope", "transferable"],
      "properties": {
        "state": {"enum": ["PASS", "ABSENT", "BLOCKED_ABSENT_EXECUTABLE"]},
        "commands": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["argv", "exit"],
            "properties": {
              "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
              "exit": {"type": "integer"}
            }
          }
        },
        "versions": {"type": "object", "additionalProperties": {"type": "string"}},
        "runtime_scope": {"type": "string", "minLength": 1},
        "transferable": {"type": "boolean"}
      }
    },
    "contract_digests": {
      "type": "object", "additionalProperties": false,
      "required": ["profile_sha256", "schema_sha256", "vectors_sha256"],
      "properties": {
        "profile_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "vectors_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "positive_results": {"$ref": "#/$defs/results"},
    "negative_results": {"$ref": "#/$defs/results"},
    "denominator": {
      "type": "object", "additionalProperties": false,
      "required": ["required", "pass", "fail", "not_exercised", "not_representable"],
      "properties": {
        "required": {"const": 10},
        "pass": {"type": "integer", "minimum": 0},
        "fail": {"type": "integer", "minimum": 0},
        "not_exercised": {"type": "integer", "minimum": 0},
        "not_representable": {"type": "integer", "minimum": 0}
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "version", "license_state"],
        "properties": {
          "name": {"type": "string"},
          "version": {"type": "string"},
          "license_state": {"type": "string"}
        }
      }
    },
    "rights_state": {"type": "string", "minLength": 1},
    "clean_room_state": {"enum": ["CLEAN_ROOM_PRECHECK_PASS", "BLOCKED", "HUMAN_REVIEW_REQUIRED"]},
    "shadow": {
      "type": "object", "additionalProperties": false,
      "required": ["observer_kind", "independence_claimed", "deltas", "dissent"],
      "properties": {
        "observer_kind": {"type": "string"},
        "independence_claimed": {"type": "boolean"},
        "deltas": {"type": "array", "items": {"type": "string"}},
        "dissent": {"type": "array", "items": {"type": "string"}}
      }
    },
    "evidence_lane": {"const": "local-deterministic canonicalization only"},
    "evidence_state": {"enum": ["PASS", "FAIL", "BLOCKED", "NOT_EXERCISED"]},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "rollback": {"const": "b63589e5a16e82fda1a9554227f2ebbb55398c8a"},
    "human_owned": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "results": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "state"],
        "properties": {
          "id": {"type": "string"},
          "state": {"enum": ["PASS", "FAIL", "NOT_EXERCISED", "NOT_REPRESENTABLE_WITH_REASON"]},
          "expected": {"type": ["string", "null"]},
          "actual": {"type": ["string", "null"]},
          "reason": {"type": "string"}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"language": {"const": "kotlin"}}},
      "then": {"properties": {"issue": {"const": 18}, "branch": {"const": "ag/C01-kotlin-vectors"}}}
    },
    {
      "if": {"properties": {"language": {"const": "swift"}}},
      "then": {"properties": {"issue": {"const": 19}, "branch": {"const": "ag/C01-swift-vectors"}}}
    },
    {
      "if": {"properties": {"language": {"const": "typescript"}}},
      "then": {"properties": {"issue": {"const": 20}, "branch": {"const": "ag/C01-typescript-vectors"}}}
    }
  ]
}
