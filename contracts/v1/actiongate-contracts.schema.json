{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://actiongate.dev/contracts/v1/actiongate-contracts.schema.json",
  "title": "ActionGate v1 contracts",
  "type": "object",
  "$defs": {
    "asciiToken": {"type":"string","minLength":1,"maxLength":256,"pattern":"^[A-Za-z0-9_.:/@-]+$"},
    "b64uSha256": {"type":"string","pattern":"^[A-Za-z0-9_-]{43}$"},
    "b64uP1363": {"type":"string","pattern":"^[A-Za-z0-9_-]{86}$"},
    "millis": {"type":"integer","minimum":0,"maximum":9007199254740991},
    "riskTier": {"enum":["R0","R1","R2","R3"]},
    "canonicalValue": {
      "oneOf": [
        {"type":"null"}, {"type":"boolean"},
        {"type":"integer","minimum":-9007199254740991,"maximum":9007199254740991},
        {"type":"string"},
        {"type":"array","items":{"$ref":"#/$defs/canonicalValue"}},
        {"type":"object","propertyNames":{"pattern":"^[A-Za-z0-9_.:-]+$"},"additionalProperties":{"$ref":"#/$defs/canonicalValue"}}
      ]
    },
    "ActionEnvelope": {
      "type":"object","additionalProperties":false,
      "required":["version","action_id","agent_id","subject_id","tool","arguments_hash","context_hash","risk_tier","audience","policy_version","issued_at_ms","expires_at_ms","nonce"],
      "properties": {
        "version":{"const":"actiongate/v1"},"action_id":{"$ref":"#/$defs/asciiToken"},"agent_id":{"$ref":"#/$defs/asciiToken"},"subject_id":{"$ref":"#/$defs/asciiToken"},
        "tool":{"$ref":"#/$defs/asciiToken"},"arguments_hash":{"$ref":"#/$defs/b64uSha256"},"context_hash":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/b64uSha256"}]},
        "risk_tier":{"$ref":"#/$defs/riskTier"},"audience":{"$ref":"#/$defs/asciiToken"},"policy_version":{"$ref":"#/$defs/asciiToken"},
        "issued_at_ms":{"$ref":"#/$defs/millis"},"expires_at_ms":{"$ref":"#/$defs/millis"},"nonce":{"$ref":"#/$defs/asciiToken"}
      }
    },
    "AuthorizationChallenge": {
      "type":"object","additionalProperties":false,
      "required":["version","challenge_id","action_digest","subject_id","device_id","audience","policy_version","nonce","issued_at_ms","expires_at_ms"],
      "properties": {
        "version":{"const":"actiongate/v1"},"challenge_id":{"$ref":"#/$defs/asciiToken"},"action_digest":{"$ref":"#/$defs/b64uSha256"},
        "subject_id":{"$ref":"#/$defs/asciiToken"},"device_id":{"$ref":"#/$defs/asciiToken"},"audience":{"$ref":"#/$defs/asciiToken"},
        "policy_version":{"$ref":"#/$defs/asciiToken"},"nonce":{"$ref":"#/$defs/asciiToken"},"issued_at_ms":{"$ref":"#/$defs/millis"},"expires_at_ms":{"$ref":"#/$defs/millis"}
      }
    },
    "HardwareSignatureProof": {
      "type":"object","additionalProperties":false,
      "required":["version","challenge_id","device_id","key_id","algorithm","signature_format","signature_b64u"],
      "properties": {
        "version":{"const":"actiongate/v1"},"challenge_id":{"$ref":"#/$defs/asciiToken"},"device_id":{"$ref":"#/$defs/asciiToken"},"key_id":{"$ref":"#/$defs/asciiToken"},
        "algorithm":{"const":"ES256"},"signature_format":{"const":"IEEE-P1363"},"signature_b64u":{"$ref":"#/$defs/b64uP1363"}
      }
    },
    "ApplicationIntegrityProof": {
      "type":"object","additionalProperties":false,
      "required":["version","challenge_id","provider","artifact_format","artifact","binding"],
      "properties": {
        "version":{"const":"actiongate/v1"},"challenge_id":{"$ref":"#/$defs/asciiToken"},
        "provider":{"enum":["android-play-integrity","android-key-attestation","apple-app-attest"]},
        "artifact_format":{"$ref":"#/$defs/asciiToken"},"artifact":{"type":"string","minLength":1,"maxLength":32768},
        "binding":{"type":"object","additionalProperties":false,"required":["action_digest","nonce"],"properties":{"action_digest":{"$ref":"#/$defs/b64uSha256"},"nonce":{"$ref":"#/$defs/asciiToken"}}}
      }
    },
    "VerificationResult": {
      "type":"object","additionalProperties":false,
      "required":["version","verification_id","challenge_id","action_digest","decision","reasons","verified_at_ms"],
      "properties": {
        "version":{"const":"actiongate/v1"},"verification_id":{"$ref":"#/$defs/asciiToken"},"challenge_id":{"$ref":"#/$defs/asciiToken"},"action_digest":{"$ref":"#/$defs/b64uSha256"},
        "decision":{"enum":["VERIFIED","DENIED","EXPIRED","REPLAY","ERROR"]},"reasons":{"type":"array","maxItems":32,"items":{"type":"string","maxLength":256}},
        "verified_at_ms":{"$ref":"#/$defs/millis"},"device_id":{"$ref":"#/$defs/asciiToken"},"key_id":{"$ref":"#/$defs/asciiToken"}
      }
    },
    "ExecutionGrant": {
      "type":"object","additionalProperties":false,
      "required":["version","grant_id","issuer","action_digest","action_id","subject_id","agent_id","tool","audience","policy_version","issued_at_ms","expires_at_ms"],
      "properties": {
        "version":{"const":"actiongate/v1"},"grant_id":{"$ref":"#/$defs/asciiToken"},"issuer":{"$ref":"#/$defs/asciiToken"},"action_digest":{"$ref":"#/$defs/b64uSha256"},
        "action_id":{"$ref":"#/$defs/asciiToken"},"subject_id":{"$ref":"#/$defs/asciiToken"},"agent_id":{"$ref":"#/$defs/asciiToken"},"tool":{"$ref":"#/$defs/asciiToken"},
        "audience":{"$ref":"#/$defs/asciiToken"},"policy_version":{"$ref":"#/$defs/asciiToken"},"issued_at_ms":{"$ref":"#/$defs/millis"},"expires_at_ms":{"$ref":"#/$defs/millis"}
      }
    },
    "AuditReceipt": {
      "type":"object","additionalProperties":false,
      "required":["version","receipt_id","action_id","action_digest","grant_id","outcome","idempotency_key","emitted_at_ms"],
      "properties": {
        "version":{"const":"actiongate/v1"},"receipt_id":{"$ref":"#/$defs/asciiToken"},"action_id":{"$ref":"#/$defs/asciiToken"},"action_digest":{"$ref":"#/$defs/b64uSha256"},
        "grant_id":{"$ref":"#/$defs/asciiToken"},"outcome":{"enum":["COMMITTED","FAILED","COMMIT_UNKNOWN","DENIED"]},"idempotency_key":{"$ref":"#/$defs/asciiToken"},
        "emitted_at_ms":{"$ref":"#/$defs/millis"},"trace_id":{"type":"string","maxLength":128},"result_digest":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/b64uSha256"}]}
      }
    },
    "LocalHandoffPacket": {
      "type":"object","additionalProperties":false,
      "required":["version","repository","issue","stage","atom","base_ref","subject_sha","branch","lease","inputs","outputs","verification","shadow","blockers","next_entry_condition","human_owned_operations"],
      "properties": {
        "version":{"const":"actiongate/v1"},"repository":{"const":"ed3c/ActionGate"},"issue":{"type":"integer","minimum":1},"stage":{"type":"string","pattern":"^P[0-8]$"},"atom":{"$ref":"#/$defs/asciiToken"},
        "base_ref":{"type":"string","minLength":1,"maxLength":256},"subject_sha":{"type":"string","pattern":"^[0-9a-f]{40}$"},"subject_tree":{"oneOf":[{"type":"string","pattern":"^[0-9a-f]{40}$"},{"const":"ABSENT"}]},
        "branch":{"type":"string","minLength":1,"maxLength":256},"pr":{"type":"string","maxLength":512},
        "lease":{"type":"object","additionalProperties":false,"required":["paths","resources"],"properties":{"paths":{"type":"array","items":{"type":"string"}},"resources":{"type":"array","items":{"type":"string"}}}},
        "inputs":{"type":"object","additionalProperties":false,"required":["receipts"],"properties":{"receipts":{"type":"array","items":{"type":"string"}}}},
        "outputs":{"type":"object","additionalProperties":false,"required":["changed_paths","artifacts"],"properties":{"changed_paths":{"type":"array","items":{"type":"string"}},"artifacts":{"type":"array","items":{"type":"string"}}}},
        "verification":{"type":"object","additionalProperties":false,"required":["commands","receipt","evidence_lane","evidence_state"],"properties":{"commands":{"type":"array","items":{"type":"string"}},"receipt":{"type":"string"},"evidence_lane":{"type":"string"},"evidence_state":{"enum":["PASS","FAIL","ABSENT","NOT_IMPLEMENTED","NOT_EXERCISED","SKIPPED_BY_POLICY","HUMAN_ADMIT_REQUIRED"]}}},
        "shadow":{"type":"object","additionalProperties":false,"required":["observer_kind","independence_claimed","deltas","dissent"],"properties":{"observer_kind":{"type":"string"},"independence_claimed":{"type":"boolean"},"deltas":{"type":"array","items":{"type":"string"}},"dissent":{"type":"array","items":{"type":"string"}}}},
        "blockers":{"type":"array","items":{"type":"string"}},"next_entry_condition":{"type":"string","minLength":1},"human_owned_operations":{"type":"array","items":{"type":"string"}}
      }
    }
  }
}
